# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadgen_pro
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# API Keys
NEVERBOUNCE_API_KEY=your_neverbounce_key
ZEROBOUNCE_API_KEY=your_zerobounce_key
CLEARBIT_API_KEY=your_clearbit_key
FULLCONTACT_API_KEY=your_fullcontact_key
HUNTER_API_KEY=your_hunter_key
CRUNCHBASE_API_KEY=your_crunchbase_key
BUILTWITH_API_KEY=your_builtwith_key

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Service (SendGrid)
SENDGRID_API_KEY=your_sendgrid_key
FROM_EMAIL=noreply@leadgenpro.com
FROM_NAME=Lead Generator Pro

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=chrome-extension://YOUR_EXTENSION_ID,http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_EMAIL_VERIFICATION=true
ENABLE_LEAD_SCORING=true
ENABLE_DATA_ENRICHMENT=true
ENABLE_ANALYTICS=true

# Subscription Tiers (Monthly Limits)
FREE_TIER_LEADS=25
STARTER_TIER_LEADS=500
PRO_TIER_LEADS=2500
BUSINESS_TIER_LEADS=10000

# Verification Settings
VERIFICATION_TIMEOUT_MS=5000
MAX_CONCURRENT_VERIFICATIONS=10

# Google Sheets API (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
