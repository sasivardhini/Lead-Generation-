{
  "manifest_version": 3,
  "name": "Lead Generator Pro",
  "version": "4.0.0",
  "description": "Professional LinkedIn lead extraction with backend integration",

  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],

  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:5173/*"
  ],

  "action": {
    "default_popup": "popup-new.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["extractor.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
